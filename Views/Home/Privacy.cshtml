@{
    ViewData["Title"] = "Cookie Policy";
}
<section class="container page">
    <h1>Cookie Policy</h1>
    <p>SkopjeDrive uses cookies to remember your language preference and to give you accurate cookie-consent status. We do not use cookies for advertising or tracking purposes.</p>
    <ul class="service-list">
        <li><strong>culture</strong> — remembers whether you prefer the English or Macedonian version of the site.</li>
        <li><strong>skopjedrive_cookie_consent</strong> — remembers that you accepted our cookie banner.</li>
    </ul>
    <p>You can clear these cookies at any time from your browser settings.</p>
</section>
